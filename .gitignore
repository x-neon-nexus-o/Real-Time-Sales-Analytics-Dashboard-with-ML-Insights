# =============================================================================
# DEPLOYMENT & PRODUCTION
# =============================================================================

# Local development secrets (NEVER commit these!)
.env.production
.env.staging
secrets/
*.pem
*.key
*.crt

# Local wsgi config (use render.yaml instead)
wsgi.py

